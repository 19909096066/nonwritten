        model
      FROM raw_materials WHERE 1=1`;
      const params = [];
      
      if (args.status && args.status !== 'all') {
        sql += ' AND status = ?';
        params.push(args.status);
      } else {
        sql += " AND status IN ('in_stock', 'split')";
      }
      
      if (args.model) {
        sql += ' AND model = ?';
        params.push(args.model);
      }
      
      sql += ' GROUP BY model';
      
      const [rows] = await pool.execute(sql, params);
      
      // 获取总计
      const [totalRows] = await pool.execute(
        `SELECT COUNT(*) as count, SUM(weight) as weight 
         FROM raw_materials WHERE status IN ('in_stock', 'split')`
      );
      
      return {
        success: true,
        data: {
          byModel: rows,
          total: totalRows[0]
        }
      };
    }
    
    case 'query_material_detail': {
      let sql = 'SELECT * FROM raw_materials WHERE 1=1';
      const params = [];
      
      if (args.batch_no) {
        sql += ' AND batch_no = ?';
        params.push(args.batch_no);
      }
      if (args.qr_code) {
        sql += ' AND qr_code = ?';
        params.push(args.qr_code);
      }
      
      sql += ' LIMIT 20';
      
      const [rows] = await pool.execute(sql, params);
      return {
        success: true,
        data: rows.map(formatMaterialDates)
      };
    }
    
    case 'query_statistics': {
      const type = args.type;
      const days = args.days || 7;
      
      if (type === 'dashboard') {
        const [stockRows] = await pool.execute(
          "SELECT COUNT(*) as count, SUM(weight) as weight FROM raw_materials WHERE status IN ('in_stock', 'split')"
        );
        const [todayIn] = await pool.execute(
          "SELECT COUNT(*) as count, SUM(weight) as weight FROM raw_materials WHERE DATE(created_at) = CURDATE() AND status IN ('in_stock', 'split')"
        );
        const [todayOut] = await pool.execute(
          "SELECT COUNT(*) as count, SUM(weight) as weight FROM operation_logs WHERE DATE(operate_time) = CURDATE() AND operation_type = 'OUT'"
        );
        const [todaySplit] = await pool.execute(
          "SELECT COUNT(*) as count, SUM(weight) as weight FROM operation_logs WHERE DATE(operate_time) = CURDATE() AND operation_type = 'SPLIT'"
        );
        
        return {
          success: true,
          data: {
            totalStock: stockRows[0].count || 0,
            totalWeight: stockRows[0].weight || 0,
            todayIn: todayIn[0].count || 0,
            todayInWeight: todayIn[0].weight || 0,
            todayOut: todayOut[0].count || 0,
            todayOutWeight: todayOut[0].weight || 0,
            todaySplit: todaySplit[0].count || 0,
            todaySplitWeight: todaySplit[0].weight || 0
          }
        };
      } else if (type === 'trend') {
        const [rows] = await pool.execute(`
          SELECT 
            DATE(operate_time) as date,
            SUM(CASE WHEN operation_type = 'IN' THEN 1 ELSE 0 END) as inCount,
            SUM(CASE WHEN operation_type = 'OUT' THEN 1 ELSE 0 END) as outCount
          FROM operation_logs
          WHERE operate_time >= DATE_SUB(CURDATE(), INTERVAL ? DAY)
          GROUP BY DATE(operate_time)
          ORDER BY date
        `, [days]);
        
        return { success: true, data: rows };
      } else if (type === 'distribution') {
        const [rows] = await pool.execute(`
          SELECT model, SUM(weight) as weight 
          FROM raw_materials 
          WHERE status IN ('in_stock', 'split')
          GROUP BY model
        `);
        return { success: true, data: rows };
      }
      break;
    }
    
    case 'query_logs': {
      const limit = args.limit || 10;
      let sql = 'SELECT * FROM operation_logs WHERE 1=1';
      const params = [];
      
      if (args.operation_type && args.operation_type !== 'all') {
        sql += ' AND operation_type = ?';
        params.push(args.operation_type);
      }
      if (args.start_date) {
        sql += ' AND DATE(operate_time) >= ?';
        params.push(args.start_date);
      }
      if (args.end_date) {
        sql += ' AND DATE(operate_time) <= ?';
        params.push(args.end_date);
      }
      
      sql += ' ORDER BY operate_time DESC LIMIT ?';
      params.push(limit);
      
      const [rows] = await pool.execute(sql, params);
      return { success: true, data: rows };
    }
    
    case 'analyze_anomaly': {
      const anomalies = [];
      
      // 检查库存异常
      if (args.type === 'stock' || args.type === 'all') {
        // 检查长期未出库的物料
        const [longStock] = await pool.execute(`
          SELECT batch_no, model, COUNT(*) as count, MIN(created_at) as first_in
          FROM raw_materials 
          WHERE status IN ('in_stock', 'split')
          AND created_at < DATE_SUB(NOW(), INTERVAL 30 DAY)
          GROUP BY batch_no, model
        `);
        
        if (longStock.length > 0) {
          anomalies.push({
            type: 'long_stock',
            severity: 'warning',
            message: `发现${longStock.length}批物料入库超过30天未出库`,
            details: longStock.slice(0, 5)
          });
        }
        
        // 检查库存不足
        const [lowStock] = await pool.execute(`
          SELECT model, SUM(weight) as weight
          FROM raw_materials 
          WHERE status IN ('in_stock', 'split')
          GROUP BY model
          HAVING weight < 5000
        `);
        
        if (lowStock.length > 0) {
          anomalies.push({
            type: 'low_stock',
            severity: 'info',
            message: `${lowStock.length}个型号库存低于5000kg`,
            details: lowStock
          });
        }
      }
      
      // 检查质量异常
      if (args.type === 'quality' || args.type === 'all') {
        // 检查今日次品率
        const [qcStats] = await pool.execute(`
          SELECT 
            COUNT(*) as total,
            SUM(CASE WHEN result = 'unqualified' THEN 1 ELSE 0 END) as unqualified
          FROM qc_purchase
          WHERE DATE(time) = CURDATE()
        `);
        
        if (qcStats[0].total > 0) {
          const rate = (qcStats[0].unqualified / qcStats[0].total * 100).toFixed(2);
          if (rate > 5) {
            anomalies.push({
              type: 'high_defect_rate',
              severity: 'warning',
              message: `今日采购质检次品率${rate}%，高于正常水平`,
              details: qcStats[0]
            });
          }
        }
      }
      
      return {
        success: true,
        data: {
          hasAnomaly: anomalies.length > 0,
          anomalies
        }
      };
    }
    
    case 'generate_report': {
      const reportType = args.report_type;
      let startDate, endDate;
      const today = new Date();
      
      if (reportType === 'daily') {
        startDate = endDate = args.date || today.toISOString().split('T')[0];
      } else if (reportType === 'weekly') {
        endDate = args.date || today.toISOString().split('T')[0];
        const d = new Date(endDate);
        d.setDate(d.getDate() - 6);
        startDate = d.toISOString().split('T')[0];
      } else if (reportType === 'monthly') {
        endDate = args.date || today.toISOString().split('T')[0];
        const d = new Date(endDate);
        d.setDate(d.getDate() - 29);
        startDate = d.toISOString().split('T')[0];
      }
      
      // 获取统计数据
      const [stockRows] = await pool.execute(
        "SELECT COUNT(*) as count, SUM(weight) as weight FROM raw_materials WHERE status IN ('in_stock', 'split')"
      );
      
      const [inRows] = await pool.execute(`
        SELECT COUNT(*) as count, SUM(weight) as weight
        FROM raw_materials
        WHERE DATE(created_at) BETWEEN ? AND ?
      `, [startDate, endDate]);
      
      const [outRows] = await pool.execute(`
        SELECT COUNT(*) as count, SUM(weight) as weight
        FROM operation_logs
        WHERE operation_type = 'OUT' AND DATE(operate_time) BETWEEN ? AND ?
      `, [startDate, endDate]);
      
      return {
        success: true,
        data: {
          reportType,
          period: { startDate, endDate },
          summary: {
            currentStock: stockRows[0].count || 0,
            currentWeight: stockRows[0].weight || 0,
            inCount: inRows[0].count || 0,
            inWeight: inRows[0].weight || 0,
            outCount: outRows[0].count || 0,
            outWeight: outRows[0].weight || 0
          }
        }
      };
    }
    
    case 'get_purchase_suggestions': {
      let sql = `
        SELECT ps.*, pp.stock_days, pp.lead_days
        FROM purchase_suggestions ps
        LEFT JOIN purchase_params pp ON ps.model = pp.model
        WHERE ps.status = 'pending'
      `;
      const params = [];
      
      if (args.model) {
        sql += ' AND ps.model = ?';
        params.push(args.model);
      }
      
      sql += ' ORDER BY ps.suggest_qty DESC';
      
      const [rows] = await pool.execute(sql, params);
      return { success: true, data: rows };
    }
    
    default:
      return { success: false, error: `未知工具: ${toolName}` };
  }
}

