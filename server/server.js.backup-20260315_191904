// AI 配置管理接口 - 保存配置
app.post('/api/ai/config', authenticateToken, async (req, res) => {
  const { provider, apiKey } = req.body;
  
  if (!provider || !AI_MODELS[provider]) {
    return res.status(400).json({ error: '无效的模型提供商' });
  }
  
  if (!apiKey || apiKey.length < 10) {
    return res.status(400).json({ error: 'API Key 无效' });
  }
  
  // 验证 API Key 是否有效
  try {
    const modelConfig = AI_MODELS[provider];
    const testResponse = await fetch(modelConfig.url, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        model: modelConfig.model,
        messages: [{ role: 'user', content: '测试' }],
        max_tokens: 10
      })
    });
    
    if (!testResponse.ok) {
      const errorData = await testResponse.json();
      return res.status(400).json({ error: 'API Key 验证失败: ' + (errorData.error?.message || '未知错误') });
    }
  } catch (e) {
    return res.status(400).json({ error: 'API Key 验证失败，请检查网络连接' });
  }
  
  // 保存配置
  const config = { provider, apiKey };
  if (saveAIConfig(config)) {
    res.json({ success: true, message: 'AI 配置保存成功' });
  } else {
    res.status(500).json({ error: '保存配置失败' });
  }
});

// AI聊天接口
app.post('/api/ai/chat', authenticateToken, async (req, res) => {
  const { messages, conversation_id } = req.body;
  
  // 获取动态配置
  const aiConfig = getAIConfig();
  
  if (!aiConfig.apiKey) {
    return res.status(500).json({ error: 'AI服务未配置，请先在设置中配置 API Key' });
  }
  
  const modelConfig = AI_MODELS[aiConfig.provider];
  if (!modelConfig) {
    return res.status(500).json({ error: 'AI模型配置无效' });
  }
  
  try {
    // 系统提示词
    const systemPrompt = {
      role: 'system',
      content: `你是一个专业的仓储管理助手，帮助用户管理无纺布仓库。

你的能力包括：
1. 查询库存信息（按型号、状态查询）
2. 查询物料详情（按批次号、二维码查询）
3. 查询统计数据（仪表盘、趋势、分布）
4. 查询操作日志
5. 分析异常情况（库存异常、质量异常）
6. 生成运营报告（日报、周报、月报）
7. 提供采购建议

回复要求：
- 用简洁自然的中文回复
- 数据用表格或列表形式展示更清晰
- 如果发现问题，主动给出建议
- 保持专业但友好的语气`
    };
    
    // 调用 AI API
    const response = await fetch(modelConfig.url, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${aiConfig.apiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        model: modelConfig.model,
        messages: [systemPrompt, ...messages]
        // 暂时禁用 function calling 以排查问题
        // tools: AI_TOOLS,
        // tool_choice: 'auto'
      })
    });
    
    const data = await response.json();
    
    if (!response.ok) {
      console.error('AI API错误:', data);
      return res.status(500).json({ error: 'AI服务暂时不可用', details: data.error });
    }
    
    // 检查是否需要调用工具
    const assistantMessage = data.choices[0].message;
    
    if (assistantMessage.tool_calls && assistantMessage.tool_calls.length > 0) {
      // 执行工具调用
      const toolResults = [];
      
      for (const toolCall of assistantMessage.tool_calls) {
        const functionName = toolCall.function.name;
        const functionArgs = JSON.parse(toolCall.function.arguments);
        
        console.log(`执行工具: ${functionName}`, functionArgs);
        
        const result = await executeToolCall(functionName, functionArgs);
        toolResults.push({
          tool_call_id: toolCall.id,
          role: 'tool',
          content: JSON.stringify(result)
        });
      }
      
      // 将工具结果发回给AI生成最终回复
      const finalResponse = await fetch(modelConfig.url, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${aiConfig.apiKey}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          model: modelConfig.model,
          messages: [
            systemPrompt,
            ...messages,
            assistantMessage,
            ...toolResults
          ]
        })
      });
      
      const finalData = await finalResponse.json();
      
      if (!finalResponse.ok) {
        console.error('GLM最终回复错误:', finalData);
        return res.status(500).json({ error: 'AI服务处理失败' });
      }
      
      return res.json({
        success: true,
        message: finalData.choices[0].message,
        tool_calls: assistantMessage.tool_calls.map(tc => ({
          name: tc.function.name,
          args: JSON.parse(tc.function.arguments)
        }))
      });
    }
    
    // 直接返回AI回复
    res.json({
      success: true,
      message: assistantMessage
    });
    
  } catch (error) {
    console.error('AI聊天错误:', error);
    res.status(500).json({ error: 'AI服务请求失败', details: error.message });
  }
});

