app.get('/api/ai/insights', authenticateToken, async (req, res) => {
  try {
    const insights = {
      anomalies: [],
      suggestions: [],
      summary: {}
    };
    
    // 获取基础统计数据
    const [stockRows] = await pool.execute(
      "SELECT COUNT(*) as count, SUM(weight) as weight FROM raw_materials WHERE status IN ('in_stock', 'split')"
    );
    
    const [todayIn] = await pool.execute(
      "SELECT COUNT(*) as count, SUM(weight) as weight FROM raw_materials WHERE DATE(created_at) = CURDATE()"
    );
    
    // 今日出库 - 从raw_materials表获取今日出库的重量
    const [todayOut] = await pool.execute(
      "SELECT COUNT(*) as count, SUM(weight) as weight FROM raw_materials WHERE DATE(out_at) = CURDATE() AND status = 'out_stock'"
    );
    
    insights.summary = {
      totalStock: stockRows[0].count || 0,
      totalWeight: stockRows[0].weight || 0,
      todayIn: todayIn[0].count || 0,
      todayInWeight: todayIn[0].weight || 0,
      todayOut: todayOut[0].count || 0,
      todayOutWeight: todayOut[0].weight || 0
    };
    
    // 检查异常
    // 1. 长期未出库
    const [longStock] = await pool.execute(`
      SELECT batch_no, model, COUNT(*) as count
      FROM raw_materials 
      WHERE status IN ('in_stock', 'split')
      AND created_at < DATE_SUB(NOW(), INTERVAL 30 DAY)
      GROUP BY batch_no, model
      LIMIT 5
    `);
    
    if (longStock.length > 0) {
      insights.anomalies.push({
        type: 'warning',
        title: '长期未出库',
        message: `发现${longStock.length}批物料入库超过30天未出库`,
        details: longStock
      });
    }
    
    // 2. 库存预警 - 使用 try-catch 防止表不存在导致整个接口失败
    try {
      const [purchaseSuggestions] = await pool.execute(`
        SELECT * FROM purchase_suggestions WHERE status = 'pending' ORDER BY suggest_qty DESC LIMIT 5
      `);
      
      if (purchaseSuggestions.length > 0) {
        insights.suggestions.push({
          type: 'purchase',
          title: '采购建议',
          message: `${purchaseSuggestions.length}个型号需要补货`,
          details: purchaseSuggestions
        });
      }
    } catch (e) {
      // purchase_suggestions 表可能不存在，忽略此错误
      console.log('采购建议查询跳过:', e.message);
    }
    
    res.json({
      success: true,
      data: insights
    });
    
  } catch (error) {
    console.error('获取AI洞察失败:', error);
    res.status(500).json({ error: '服务器错误' });
  }
});

