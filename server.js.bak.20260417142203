  const parseXml = (xmlStr) => {
    const result = {};
    const regex = /<(\w+)><!\[CDATA\[(.*?)\]\]><\/\1>|<(\w+)>(.*?)<\/\3>/g;
    let match;
    while ((match = regex.exec(xmlStr)) !== null) {
      const key = match[1] || match[3];
      const value = match[2] || match[4];
      if (key && value) result[key] = value;
    }
    return result;
  };
  
  const data = parseXml(xml);
  
