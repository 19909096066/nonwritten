        [itemId, listId, item.batch_no, item.package_no, item.weight, item.qr_code, item.id]
      );
      importedCount++;
    }
    
    res.json({ 
      success: true, 
      message: `成功将 ${importedCount} 条记录导入发货清单`,
      list_id: listId,
